NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, never prefixed with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_URL=

# HelloAsso webhook
# https://api.helloasso.com in production, https://api.helloasso-sandbox.com for tests
HELLOASSO_API_URL=
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
# openssl rand -hex 32, also put in the notification URL: …/api/helloasso/webhook?secret=…
HELLOASSO_WEBHOOK_SECRET=
HELLOASSO_ORG_SLUG=
# Comma separated
HELLOASSO_FORM_SLUGS=
ALLOW_FREE_MEMBERSHIP=false

# Email (Brevo: smtp-relay.brevo.com, port 587, SMTP login + SMTP key)
# Local: SMTP_HOST=127.0.0.1, SMTP_PORT=54325 (Mailpit), no user / password
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Sender validated in Brevo, on a domain authenticated in Brevo (not @gmail.com)
EMAIL_FROM="AAAH! <noreply@domaine>"
# Receives contact messages and admin notifications
CONTACT_EMAIL=aaah.contact@gmail.com

# Cloudflare Turnstile (contact form). Local test keys:
# site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
