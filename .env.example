# HelloAsso webhook
# https://api.helloasso.com in production, https://api.helloasso-sandbox.com for tests
HELLOASSO_API_URL=
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
# openssl rand -hex 32, also put in the notification URL: …/api/helloasso/webhook?secret=…
HELLOASSO_WEBHOOK_SECRET=
HELLOASSO_ORG_SLUG=
# Comma separated
HELLOASSO_FORM_SLUGS=
ALLOW_FREE_MEMBERSHIP=false
